{
  "name": "pastforward",
  "version": "1.0.0",
  "description": "PastForward — upcycled vinyl wall decor, posters, prints and polaroids. Single-file site assembled by build.py.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "python3 build.py",
    "build:all": "python3 build.py --all",
    "catalogue": "python3 build_catalogue.py",
